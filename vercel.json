{
    "version": 2,
    "functions": {
        "api/**/*.js": {
            "maxDuration": 25,
            "memory": 1024
        }
    },
    "rewrites": [
        {
            "source": "/voice",
            "destination": "/voice.html"
        },
        {
            "source": "/brod",
            "destination": "/brod/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)\\.html",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
            ]
        },
        {
            "source": "/voice",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
            ]
        },
        {
            "source": "/brod",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
                { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
            ]
        },
        {
            "source": "/brod/(.*)",
            "headers": [
                { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
            ]
        }
    ]
}
